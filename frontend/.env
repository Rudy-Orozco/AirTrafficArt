# Center of the display and how many nautical miles fit across half the screen's
# short side. Centered on DFW airport. After changing the location, rebuild the
# map with: python3 scripts/build_basemap.py
VITE_CENTER_LAT=32.8998
VITE_CENTER_LON=-97.0403
VITE_VIEW_RADIUS_NM=30

# How often to fetch new positions. Planes are interpolated between fetches.
# adsb.lol returns HTTP 429 to many clients polling every 5s; 10s is reliable.
VITE_POLL_MS=10000
