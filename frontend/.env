# Which airport preset to show by default (see airports.json for the list).
# Override at any time without rebuilding by opening the app with ?airport=LAX
#
# To add an airport: add it to airports.json, then build its map with
#   python3 scripts/build_basemap.py <CODE>
#
# Everything else (timings, colors, trails, the board) is in src/config.ts.
VITE_AIRPORT=LAX
